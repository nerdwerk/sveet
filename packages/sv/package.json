{
	"name": "@nerdwerk/sv",
	"version": "1.0.0-rc.3",
	"description": "sveet for the Svelte CLI: bunx sv create my-app --add @nerdwerk",
	"keywords": [
		"sv-add",
		"svelte",
		"sveltekit",
		"bun",
		"starter"
	],
	"homepage": "https://github.com/nerdwerk/sveet",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nerdwerk/sveet.git",
		"directory": "packages/sv"
	},
	"license": "MIT",
	"type": "module",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"default": "./dist/index.mjs"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "bun scripts/pack.ts && bun build src/index.js --outfile dist/index.mjs --target node --packages external",
		"test": "bash test.sh",
		"prepublishOnly": "bun run build"
	},
	"peerDependencies": {
		"sv": "^1.7.0"
	},
	"devDependencies": {
		"sv": "^1.7.0"
	}
}
