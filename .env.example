# Copy to .env with `bun run setup` (it also generates the secret).
# Every variable is declared and documented in src/env.ts.

# SQLite file. Created by `bun run db:migrate` / `db:reset`.
DATABASE_PATH=local.db

# Public URL of the app — Better Auth builds sign-in links from it.
ORIGIN=http://localhost:5173
BETTER_AUTH_SECRET=

# Mail (src/lib/server/mail.ts). `console` prints sign-in links to the server
# log. When unset, `dev` logs and a built server sends via Scaleway — keep this
# line so `bun run preview` works without credentials.
MAIL_TRANSPORT=console
# MAIL_FROM=login@mail.example.com
# MAIL_FROM_NAME=
# MAIL_REPLY_TO=
# SCW_SECRET_KEY=
# SCW_DEFAULT_PROJECT_ID=
# SCW_DEFAULT_REGION=fr-par
