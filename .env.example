# Copy this file to .env (or run `bun run setup`, which also generates a secret).

# --- Database (bun:sqlite) ---
# Path to the SQLite file. Created automatically on the first `bun run db:migrate`.
DATABASE_PATH=local.db

# --- Better Auth ---
ORIGIN=http://localhost:5173
# Generate a strong secret: `openssl rand -base64 32` (or run `bun run setup`).
BETTER_AUTH_SECRET=
