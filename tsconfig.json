	"compilerOptions": {
		"sourceMap": true,
		"strict": true,
		// `bun` pulls in the bun globals and the `bun:sqlite` module types.
		"types": ["$app/types", "bun"]
	},
	"include": [
		"src",
		"tests",
		"scripts",
		"vite.config.ts",
		"drizzle.config.ts",
		"playwright.config.ts"
	]
}
