{
	"name": "sveet",
	"version": "1.0.0",
	"description": "An opinionated, agent-first SvelteKit starter: bun, SQLite, Better Auth, ui-sdk, Fly.io.",
	"license": "MIT",
	"private": true,
	"type": "module",
	"engines": {
		"bun": ">=1.4.4"
	},
	"sveet": {
		"version": "1.0.0"
	},
	"bun-create": {
		"postinstall": "rm -rf packages docs && bun run setup",
		"start": "bun run sandbox"
	},
	"scripts": {
		"setup": "bun scripts/setup.ts",
		"dev": "bun --bun vite dev",
		"build": "bun --bun vite build",
		"start": "./build/server",
		"prepare": "svelte-kit sync || echo \"\"",
		"check": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "bun --bun vitest",
		"test:e2e": "bun scripts/test-e2e.ts",
		"test:setup": "playwright install chromium",
		"test": "bun run test:unit --run && bun run test:e2e",
		"verify": "bun run lint && bun run check && bun run test",
		"deploy": "bash scripts/deploy.sh",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun src/lib/server/db/migrate.ts",
		"db:seed": "bun src/lib/server/db/seed-cli.ts",
		"db:reset": "bun src/lib/server/db/reset-cli.ts && bun run db:seed",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "bun scripts/auth-schema.ts",
		"deps:update": "bash scripts/update-deps.sh",
		"hooks:install": "git config core.hooksPath .githooks",
		"sandbox": "bash scripts/sandbox.sh"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@ui-sdk/core": "^0.1.0-beta.13",
		"@ui-sdk/svelte": "^0.1.0-beta.13",
		"better-auth": "^1.7.27",
		"drizzle-orm": "^0.45.4"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-bun": "^1.0.2",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/bun": "^1.4.5",
		"@typescript/native": "npm:typescript@^7",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.59.0",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	}
}
