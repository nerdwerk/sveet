{
	"name": "sveet-build",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "bun --bun vite dev",
		"build": "bun --bun vite build",
		"preview": "bun --bun vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "bun run test:unit --run && bun run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"setup": "bun scripts/setup.mjs",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun run src/lib/server/db/migrate.ts",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "bunx @better-auth/cli@latest generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
		"db:reset": "rm -f local.db local.db-wal local.db-shm && bun run db:migrate"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.3.2",
		"@types/node": "^22.20.1",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.9.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.66.0",
		"vite": "^8.2.0",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@lucide/svelte": "^1.28.0",
		"better-auth": "^1.6.26",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tw-animate-css": "^1.4.0"
	}
}
